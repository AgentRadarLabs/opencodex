{
  "name": "@bitkyc08/opencodex",
  "version": "2.100.0",
  "description": "Universal provider proxy for OpenAI Codex & Claude Code — use any LLM with Codex CLI/App/SDK and Claude Code",
  "type": "module",
  "main": "./bin/package-main.mjs",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "default": "./bin/package-main.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "opencodex": "./bin/ocx.mjs",
    "ocx": "./bin/ocx.mjs"
  },
  "files": [
    "bin",
    "src",
    "gui/dist",
    "assets/banner.png",
    "assets/architecture.png",
    "assets/claude-code-models.gif",
    "assets/codex-app-picker.png",
    "assets/sponsors/orcarouter.png",
    "assets/sponsors/tokenlab-light.png",
    "assets/sponsors/tokenlab-dark.png",
    "README.md",
    "SPONSORS.md",
    "AGENTS_INSTALL.md",
    "native/remote-workspace-helper/Cargo.toml",
    "native/remote-workspace-helper/Cargo.lock",
    "native/remote-workspace-helper/src",
    "native/ocx-child/Cargo.toml",
    "native/ocx-child/Cargo.lock",
    "native/ocx-child/src",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "trustedDependencies": [
    "bun"
  ],
  "testRunnerBun": "1.4.4",
  "scripts": {
    "dev": "bun run src/cli/index.ts start",
    "dev:proxy": "bun run src/cli/index.ts start",
    "dev:gui": "cd gui && bun run dev",
    "start": "bun run src/cli/index.ts start",
    "test": "bun scripts/test.ts",
    "test:changed": "bun scripts/test.ts --changed=dev",
    "test:gateway-quota": "bun scripts/test.ts tests/adapters/anthropic/anthropic-quota-dispatch.test.ts tests/adapters/anthropic/anthropic-funded-roster.test.ts tests/adapters/anthropic/anthropic-sidecar-account-failover.test.ts tests/adapters/anthropic/anthropic-account-pool.test.ts tests/adapters/anthropic/anthropic-replay.test.ts tests/claude-integration/messages-native-combo.test.ts tests/claude-integration/claude-inbound-cache-stabilize.test.ts tests/responses/responses-anthropic-billing-send-budget.test.ts tests/responses/responses-send-budget-counts.test.ts tests/adapters/adapter-inner-send-budget.test.ts tests/usage/key-attribution.test.ts tests/server/agentradar-account-pin-e2e.test.ts tests/server/agentradar-account-pin-parity-e2e.test.ts tests/adapters/anthropic/anthropic-pool-extra-usage-400.test.ts tests/adapters/anthropic/anthropic-weekly-spent-gate.test.ts tests/adapters/anthropic/anthropic-agentradar-pool-parity.test.ts tests/adapters/anthropic/anthropic-family-claim-429.test.ts tests/server/terminal-guard-agentradar-rotation.test.ts tests/routing/router-combo-400-quota-echo.test.ts tests/responses/responses-compact-400-quota-echo.test.ts tests/routing/routing-analytics-physical.test.ts tests/lib/call-usage-line-log.test.ts tests/lib/upstream-refusal-log.test.ts tests/server/agentradar-account-pin-native-e2e.test.ts tests/claude-integration/agentradar-hosted-fidelity.test.ts tests/claude-integration/agentradar-hosted-tap.test.ts tests/adapters/anthropic/anthropic-agentradar-429.test.ts tests/server/image-bridge-runturn-pacing.test.ts tests/claude-integration/agentradar-count-tokens.test.ts tests/responses/agentradar-hosted-advisor-ceiling.test.ts",
    "typecheck": "bun check --no-script --noEmit",
    "typecheck:tsc": "bun x tsc --noEmit",
    "typecheck:gui:if-changed": "bun scripts/typecheck-gui-if-changed.ts",
    "audit:high": "bun audit --audit-level=high && cd gui && bun audit --audit-level=high --ignore=GHSA-fc5q-39xc-vjpf",
    "privacy:scan": "bun scripts/privacy-scan.ts",
    "favicons": "bun scripts/brand-favicons.ts",
    "favicons:check": "bun scripts/brand-favicons.ts --check",
    "docs:clients": "bun scripts/generate-client-support-matrix.ts",
    "docs:clients:check": "bun scripts/generate-client-support-matrix.ts --check",
    "skill:surface": "bun scripts/generate-ocx-skill-surface.ts",
    "skill:surface:check": "bun scripts/generate-ocx-skill-surface.ts --check",
    "structure:index": "bun scripts/structure-ssot.ts --fix",
    "structure:check": "bun scripts/structure-ssot.ts",
    "ratchet:update": "bun scripts/file-size-ratchet.ts --update",
    "generate:model-metadata": "bun scripts/generate-model-metadata.ts",
    "build:gui": "cd gui && bun install --frozen-lockfile && bun run build && cd .. && bun run prepare:package",
    "build:remote-workspace-helper": "cargo build --release --locked --manifest-path native/remote-workspace-helper/Cargo.toml",
    "test:remote-workspace-helper": "cargo test --locked --manifest-path native/remote-workspace-helper/Cargo.toml",
    "build:ocx-child": "cargo build --release --locked --manifest-path native/ocx-child/Cargo.toml",
    "test:ocx-child": "cargo test --locked --manifest-path native/ocx-child/Cargo.toml && cargo test --locked --manifest-path native/ocx-child/Cargo.toml --features link-ws-test-gate",
    "build:standalone": "bun scripts/build-standalone.ts",
    "test:macos": "swift run --package-path app MenuBarCoreTests",
    "prepare:package": "bun scripts/prepare-package.ts",
    "prepack": "bun run prepare:package",
    "prepublishOnly": "bun run audit:high && bun run typecheck:tsc && bun run build:gui",
    "release": "bun scripts/release.ts",
    "release:watch": "bun scripts/release.ts watch",
    "prepush": "bun run typecheck && bun run typecheck:gui:if-changed && bun run lint:gui:if-changed && bun run test && bun run privacy:scan && bun run doctor:gui:if-changed",
    "lint:gui": "cd gui && bun run lint",
    "lint:gui:if-changed": "bun scripts/lint-gui-if-changed.ts",
    "doctor:gui": "cd gui && bun run doctor",
    "doctor:gui:full": "cd gui && bun run doctor:full",
    "doctor:gui:if-changed": "bun scripts/doctor-gui-if-changed.ts",
    "setup:hooks": "bun scripts/setup-hooks.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@napi-rs/keyring": "1.3.0",
    "bun": "1.4.4",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  },
  "optionalDependencies": {
    "wreq-js": "2.3.1"
  },
  "overrides": {
    "@hono/node-server": "2.1.0",
    "body-parser": "2.4.0",
    "fast-uri": "^3.1.7",
    "hono": "4.13.13",
    "ip-address": "^10.7.4",
    "qs": "^6.16.1"
  },
  "keywords": [
    "codex",
    "openai",
    "proxy",
    "llm",
    "ollama",
    "anthropic",
    "responses-api",
    "claude-code",
    "claude",
    "codex-cli",
    "gemini",
    "grok",
    "deepseek",
    "chatgpt",
    "llm-proxy",
    "ai-gateway",
    "openrouter"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lidge-jun/opencodex.git"
  },
  "homepage": "https://lidge-jun.github.io/opencodex/",
  "bugs": {
    "url": "https://github.com/lidge-jun/opencodex/issues"
  },
  "license": "MIT"
}
